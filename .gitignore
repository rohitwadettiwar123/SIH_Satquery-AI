# ─────────────────────────────────────────────────────────────────────────────
# SatQuery AI  –  .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets ───────────────────────────────────────────────────────────────
.env
*.pem
*.key
secrets/

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
.eggs/
MANIFEST

# ── Virtual environments ──────────────────────────────────────────────────
.venv/
venv/
ENV/
env.bak/
.env/

# ── Testing / Coverage ────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# ── Type checking ─────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# ── Linting ───────────────────────────────────────────────────────────────
.ruff_cache/

# ── IDEs ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Node / Frontend ───────────────────────────────────────────────────────
node_modules/
.next/
out/
.nuxt/
.cache/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Data / Uploads  (do NOT commit raw satellite imagery) ─────────────────
backend/data/uploads/*
!backend/data/uploads/demo_*.jpg
!backend/data/uploads/demo_*.png
backend/data/audit/
backend/data/reports/

# ── Satellite Image Formats ───────────────────────────────────────────────
*.tif
*.tiff
*.geotiff
*.img
*.hdf
*.h5
*.nc
*.jp2

# ── Jupyter Notebooks checkpoints ────────────────────────────────────────
.ipynb_checkpoints/

# ── Misc ──────────────────────────────────────────────────────────────────
*.bak
*.tmp
*.orig
